        reason = player.bound["Reason"]
        print(type(reason))
        allowed_cmds = game.allowed_cmd[reason]
        if cmd in allowed_cmds:
            result = await command(cmd,player,*args)
        else:
            result = {'message': "that command is not allowed right now."}
    else:
